{
  "name": "claudish-to-english-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that rewrites agent-written pull request descriptions into plain English",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --minify",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "typecheck": "tsc --noEmit",
    "all": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
